# Instalado pelo deploy.sh em /etc/systemd/system/realme-monitor.service
[Unit]
Description=Monitor do Realme C55
After=network-online.target

[Service]
WorkingDirectory=/opt/realme-monitor
EnvironmentFile=/opt/realme-monitor/.env
Environment=MONITOR_DATA=/var/lib/realme-monitor
StateDirectory=realme-monitor
ExecStart=/usr/bin/env python3 /opt/realme-monitor/servidor.py
Restart=always
RestartSec=5
DynamicUser=yes

[Install]
WantedBy=multi-user.target
