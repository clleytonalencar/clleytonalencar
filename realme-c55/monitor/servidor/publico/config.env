# Configuração do monitor. Fica no servidor: mude aqui e o celular aplica na próxima rodada.
INTERVALO_SEG=3600         # de quanto em quanto tempo verificar (3600 = 1 hora)
RAM_MIN_PCT=15             # abaixo disso de RAM disponível, fecha apps em segundo plano
DISCO_MIN_PCT=20           # abaixo disso de armazenamento livre, limpa caches e alerta
TEMP_MAX=42                # °C da bateria: acima disso, alerta e alivia o processamento
UPTIME_MAX_DIAS=7          # ligado há mais dias que isso, recomenda reiniciar
REINICIO_AUTO=0            # 1 = reinicia sozinho de madrugada (03h-05h), tela apagada e carregando
MANUTENCAO_DIARIA=1        # 1 = faxina completa todo dia de madrugada (ou na primeira chance se o celular estava desligado)
BATERIA_MIN_MANUTENCAO=30  # % mínima para a faxina rodar fora do carregador
REAPLICAR_DEBLOAT=1        # 1 = se uma atualização trouxer de volta um app da pacotes.txt, remove de novo
ANIMACAO=0.5               # escala de animação que deve ser mantida (vazio = não mexer)
